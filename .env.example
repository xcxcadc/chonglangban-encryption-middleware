# 服务监听
PORT=3000
SERVICE_LABEL=chonglangban-encryption-middleware

# V2Board 后端根地址，不要包含 /api/v1
BACKEND_API_URL=https://panel.example.com

# 与 Chonglangban 前端 API_MIDDLEWARE_KEY 完全一致，必须是 16 位十六进制字符
AES_KEY=replace-with-16-hex-characters

# 加密协议：auto=同时兼容 EZ v1 和 AES-GCM v2；legacy=仅 v1；aead=仅 v2
ENCRYPTION_PROTOCOL=auto

# v2 使用 AES-256-GCM，填写 64 位十六进制密钥；不启用 v2 时可留空
AEAD_KEY=

# 与前端 API_MIDDLEWARE_PATH 完全一致
PATH_PREFIX=/clb/clb

# 可同时配置多个加密入口，逗号分隔；用于平滑迁移旧路径
ENCRYPTED_PATH_PREFIXES=/clb/clb

# V2Board API 路径前缀
API_PREFIX=/api/v1

# 解密后的 /sub/... 请求会直接转发，不拼接 API_PREFIX
SUBSCRIPTION_PREFIX=/sub

# 可配置多个订阅标记，逗号分隔；解密后的路径命中任意标记即直通后端
SUBSCRIPTION_PREFIXES=/sub

# 允许的网页来源，多个来源用逗号分隔；生产环境建议填写你的前端域名
ALLOWED_ORIGINS=*

# 支付回调原路径白名单，多个用逗号分隔；支持末尾 * 前缀匹配
PAYMENT_NOTIFY_PATHS=/api/v1/guest/payment/notify/*

# 是否允许通过中间件前缀直接访问未加密的订阅路径
# 建议生产环境关闭；关闭后请使用 v2 加密订阅链接
ALLOW_PLAIN_SUBSCRIPTIONS=false

# V2Board 默认订阅入口；多个路径用逗号分隔，支持末尾 * 前缀匹配
PLAIN_SUBSCRIPTION_PATHS=/api/v1/client/subscribe

REQUEST_TIMEOUT=20000
MAX_BODY_BYTES=8388608
ENABLE_LOGGING=false
DEBUG_MODE=false
